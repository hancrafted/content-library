{
  "name": "content-library",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . && npm run lint:boundaries",
    "lint:boundaries": "depcruise src",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "knip": "knip",
    "prepare": "husky",
    "verify": "archgate check && npm run lint && prettier --check . && npm run typecheck && vitest run && knip && mh check",
    "verify:commit": "lint-staged && archgate check && npm run lint:boundaries && npm run typecheck && vitest run",
    "test:build": "vitest run --config vitest.build.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@hancrafted/markdown-harness": "~0.0.6",
    "@next/eslint-plugin-next": "~16.4.0",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitest/coverage-v8": "~5.0.3",
    "archgate": "~0.55.0",
    "dependency-cruiser": "~18.5.0",
    "eslint": "~10.12.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-check-file": "~3.3.2",
    "husky": "~9.1.7",
    "knip": "~6.40.0",
    "lint-staged": "~17.6.0",
    "prettier": "~3.9.9",
    "prettier-plugin-organize-imports": "~4.3.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vitest": "~5.0.3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "~1.4.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "lucide-react": "~1.53.0",
    "next": "~16.4.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "tailwind-merge": "~3.7.0"
  }
}
