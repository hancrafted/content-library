{
  "name": "content-library",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . && npm run lint:boundaries",
    "lint:boundaries": "depcruise src",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "knip": "knip",
    "prepare": "husky",
    "preflight": "node skills/worktree/scripts/preflight.ts",
    "archgate:full": "archgate check --base $(git rev-list --max-parents=0 HEAD)",
    "verify": "npm run preflight && npm run archgate:full && npm run lint && prettier --check . && npm run typecheck && vitest run && knip && npm run check:docs && echo \"✔ verify: PASS\" || (echo \"✖ verify: FAIL (the first error above names the step)\" >&2; exit 1)",
    "verify:commit": "npm run preflight && lint-staged && archgate check && npm run lint:boundaries && npm run typecheck && vitest run",
    "check:docs": "mh check && npm run check:skills",
    "test:build": "vitest run --config vitest.build.config.ts",
    "wt:new": "node skills/worktree/scripts/worktree.ts new",
    "wt:done": "node skills/worktree/scripts/worktree.ts done",
    "check:sources": "node skills/new-episode/scripts/check-sources.ts",
    "convert-reference": "node skills/new-episode/scripts/convert-reference.ts",
    "episode:status": "node skills/new-episode/scripts/status.ts",
    "preview": "node skills/visual-check/scripts/preview.ts",
    "inspect-page": "node skills/visual-check/scripts/inspect-page.ts",
    "episode:log": "node skills/new-episode/scripts/log.ts",
    "episode:trace": "node skills/new-episode/scripts/trace.ts",
    "episode:query": "node skills/new-episode/scripts/query.ts",
    "episode:run": "node skills/new-episode/scripts/run.ts",
    "episode:runs-csv": "node skills/new-episode/scripts/runs-csv.ts",
    "episode:spec": "node skills/new-episode/scripts/spec.ts",
    "episode:spec-preview": "node skills/new-episode/scripts/spec-preview.ts",
    "episode:backfill-identity": "node skills/new-episode/scripts/backfill-identity.ts",
    "check:skills": "mh check --root skills --config skills/markdown-harness.config.yaml && for c in skills/*/markdown-harness.config.yaml; do test ! -e \"$c\" || mh check --root \"$(dirname \"$c\")\" --config \"$c\" || exit 1; done"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@hancrafted/markdown-harness": "~0.0.6",
    "@next/eslint-plugin-next": "~16.4.0",
    "@tailwindcss/postcss": "~4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitest/coverage-v8": "~5.0.3",
    "archgate": "~0.55.0",
    "cheerio": "~1.2.0",
    "dependency-cruiser": "~18.5.0",
    "eslint": "~10.12.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-better-tailwindcss": "~4.9.0",
    "eslint-plugin-check-file": "~3.3.2",
    "husky": "~9.1.7",
    "knip": "~6.40.0",
    "lint-staged": "~17.6.0",
    "postcss": "~8.5.29",
    "prettier": "~3.9.9",
    "prettier-plugin-organize-imports": "~4.3.0",
    "tailwindcss": "~4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vitest": "~5.0.3",
    "yaml": "~2.9.1"
  },
  "dependencies": {
    "@gsap/react": "~2.1.2",
    "@radix-ui/react-slot": "~1.4.0",
    "@radix-ui/react-tabs": "~1.2.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "gsap": "~3.15.0",
    "lucide-react": "~1.53.0",
    "next": "~16.4.0",
    "next-intl": "~4.14.9",
    "react": "~19.3.0",
    "react-colorful": "~5.8.1",
    "react-dom": "~19.3.0",
    "tailwind-merge": "~3.7.0"
  }
}
