{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".archgate/adrs/*.rules.ts",
    "src/page-assembly/i18n-request.ts",
    "skills/*/scripts/*.pure.ts",
    "skills/{new-episode,episode-promote,author-hitl-workflow}/scripts/*.ts",
    "skills/to-decision-html/scripts/{grade-page,prove}.ts",
    "skills/to-decision-html/scripts/checks/*.ts",
    "skills/to-decision-html/evals/{run,regrade,sweep}.ts"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "*.ts", "*.mjs", ".archgate/**/*.ts", "tools/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["magick", "marker_single", "pdfinfo", "pdftoppm", "yt-dlp"]
}
