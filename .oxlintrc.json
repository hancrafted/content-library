      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "better-tailwindcss/no-unknown-classes": [
          "error",
          {
            "ignore": [
              "^hero-glow(--accent)?$",
              "^deck-unsettled$",
              "^s2-arrows-active$",
              "^s2-arrow-group$",
              "^s2-flow-dash$",
              "^is-active$",
              "^dark$",
              "^card-hover(--raise|--outline)?$",
              "^focus-group(--dim-others|__item)?$",
              "^hover-reveal(__detail)?$"
            ]
          }
        ],
        "better-tailwindcss/no-restricted-classes": [
          "error",
          {
            "restrict": [
              {
                "pattern": "(?:^|:)!?-?(?:text|bg|border|ring|ring-offset|outline|fill|stroke|from|via|to|shadow|divide|accent|caret|decoration|placeholder)-(?:(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-\\d|black|white)",
                "message": "Palette colour: use a token utility (bg-primary, text-muted-foreground) or bg-(--slide-token) (FE-011)."
              },
              {
                "pattern": "(?:^|:)!?-?(?:text|bg|border|ring|ring-offset|outline|fill|stroke|from|via|to|shadow|divide|accent|caret|decoration|placeholder)-\\[(?:color:)?(?:#|rgba?\\(|hsla?\\(|oklch\\(|oklab\\(|lab\\(|lch\\(|hwb\\(|color-mix\\((?![^\\]]*var\\())",
                "message": "Arbitrary colour: declare a Slide token in the CSS module, light and dark, and reference it (FE-011)."
              },
              {
                "pattern": "(?:^|:)!?-?text-(?:xs|sm|base|lg|[2-9]xl)$",
                "message": "Size outside the roles: use text-heading, text-subheading, text-body or text-caption (FE-011)."
              },
              {
                "pattern": "(?:^|:)!?-?text-\\[[\\d.]+(?:px|rem|em|vw|vh|%|ch|pt)\\]",
                "message": "Arbitrary size: use a role (text-heading, text-subheading, text-body, text-caption) (FE-011)."
              },
              {
                "pattern": "(?:^|:)(?:sm|md|lg|xl|2xl|min-[^:]+|max-[^:]+|@[^:]+):(?:[^:]+:)*!?text-(?:hero|heading|subheading|body|caption)$",
                "message": "A role scales fluidly with clamp(): drop the breakpoint prefix from a size (FE-011)."
              },
              {
                "pattern": "(?:^|:)!?-?font-(?:thin|extralight|light|bold|extrabold|black|\\[\\d.*)$",
