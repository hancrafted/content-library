{
  // The one formatter config (GEN-005). `printWidth` is explicit: oxfmt's default of 100 would reflow the repo.
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  // Import sorting is its own change (#615); oxfmt would otherwise sort package.json keys too.
  "sortPackageJson": false,
  // What oxfmt skips, beside .gitignore. Patterns are relative to this file.
  "ignorePatterns": [
    ".archgate/rules.d.ts",
    "node_modules",
    "coverage",
    "dist",
    ".agents/skills/*",
    // Agent-written staging research files, and their fixture: research.md keeps `[n]: <url> "title"`, which a formatter rewrites.
    "skills/new-episode/assets/sample-episode",
    "docs/episodes/*/research/",
    // An Episode's prototype rounds, kept byte for byte for the retro; their sources are fragments concatenated by build.mjs.
    "docs/episodes/*/prototype/",
    // Han's LinkedIn posts, kept byte for byte as he posted them: the learn branch diffs against them.
    "skills/linkedin-author-post/examples",
    // Frozen evaluation sources retain the original bytes.
    ".vitest",
    ".claude/settings.local.json",
    ".next",
    "out",
    "next-env.d.ts",
    // The Design archive: generated by `npm run episode:archive`, never edited by hand.
    "design-archive",
    // Living HTML Specs, hand-maintained with /to-decision-html.
    "docs/features/explorables/*.spec.html",
  ],
}
