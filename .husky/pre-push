# git passes the pushed refs on stdin. Read them first: archgate reads a non-TTY
# stdin as its file list, which once shrank this hook's check to zero rules.
refs=$(cat)

npm run verify </dev/null || exit 1

# The browser lane never runs in CI: run it here when the push changes what it covers.
zero=0000000000000000000000000000000000000000
changed=$(printf '%s\n' "$refs" | while read -r _ local _ remote; do
  [ -z "$local" ] || [ "$local" = "$zero" ] && continue
  if [ "$remote" = "$zero" ]; then git diff --name-only "origin/main...$local"; else git diff --name-only "$remote" "$local"; fi
done)
if printf '%s\n' "$changed" | grep -qE '^(skills/visual-check/|skills/new-episode/scripts/spec-preview|vitest\.browser\.config\.ts|src/components/|src/app/|tests/browser/)'; then
  # The a11y test drives the served export, so the lane builds it and serves it on the preview port, then stops it.
  echo "push touches the browser lane: building, serving and running test:browser"
  npm run build </dev/null || exit 1
  port=${PREVIEW_PORT:-4300}
  node skills/visual-check/scripts/preview.ts </dev/null >/dev/null 2>&1 &
  server=$!
  # `|| true`: under dash the trap's status becomes the hook's, and the second kill finds the server already gone.
  trap 'kill "$server" 2>/dev/null || true' EXIT
  for _ in $(seq 1 50); do curl -fs -o /dev/null "http://localhost:$port/" && break; sleep 0.2; done
  npm run test:browser </dev/null || exit 1
  kill "$server" 2>/dev/null
fi

# A push to main triggers the Pages deploy, so it also runs the build lanes
# verify skips. Branch pushes stay fast; CI builds them on the PR.
if printf '%s\n' "$refs" | grep -q ' refs/heads/main '; then
  echo "push to main: running build and test:build"
  npm run build </dev/null && npm run test:build </dev/null || exit 1
fi
