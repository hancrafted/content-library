# Resources (design-ADR 0019): the four pages that were served under /episodes/ moved to their type's path. The
# Explorable explanation pages (now Explorable pages, below) and the two Master slide pages split out of one page each, so
# their old URLs land on an overview; the two Episode templates keep a page of their own. An old page-template or slides link lands on the same
# place, in one hop.
/episodes/explorable-explanations/*        /explorables/                                301
/de/episodes/explorable-explanations/*     /de/explorables/                             301
/episodes/slide-master/*                   /resources/                                  301
/de/episodes/slide-master/*                /de/resources/                               301
/episodes/episode-template/*               /episode-templates/episode-template/         301
/de/episodes/episode-template/*            /de/episode-templates/episode-template/      301
/episodes/workshop-template/*              /episode-templates/workshop-template/        301
/de/episodes/workshop-template/*           /de/episode-templates/workshop-template/     301
/episodes/page-template/                   /episode-templates/episode-template/         301
/de/episodes/page-template/                /de/episode-templates/episode-template/      301
/episodes/slides/                          /resources/                                  301
/de/episodes/slides/                       /de/resources/                               301

# Explorable pages (spec #404): the three pages that were Resources at /explorable-explanations/<slug>/ moved to
# /explorables/<slug>/, same slug, same locale, in one hop.
/explorable-explanations/*                 /explorables/:splat                          301
/de/explorable-explanations/*              /de/explorables/:splat                       301

# The AI disciplines Explorable became AI capability: its old URL lands on the new page. The page's Explorable now
# sits at #play, so an old #ai-disciplines link lands at the top of the page, on its hero.
/explorables/ai-disciplines/*              /explorables/ai-capability/:splat            301
/de/explorables/ai-disciplines/*           /de/explorables/ai-capability/:splat         301
